{
  "name": "mlegls-pi",
  "version": "0.1.0",
  "description": "Personal pi package for mlegls",
  "scripts": {
    "setup": "bun install --frozen-lockfile --ignore-scripts && bun install --cwd lib/outline-read --frozen-lockfile && bun install --cwd extensions/disabled/lsp --frozen-lockfile && bun install --frozen-lockfile --cwd skills/enabled/all/mlegls/conventions/tracker/scripts",
    "test:board": "bun test lib/board extensions/disabled/board",
    "test:exa": "bun test lib/exa extensions/disabled/exa",
    "test:lsp": "bun test extensions/lsp",
    "test:outline-read": "bun test lib/outline-read",
    "test:session": "bun test lib/session",
    "test:lib": "bun test lib",
    "test:system-prompt": "bun test extensions/system-prompt",
    "test:workspace": "bun test extensions/workspace",
    "test:tracker": "bun test --cwd skills/enabled/all/mlegls/conventions/tracker/scripts"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/exec/index.ts",
      "./extensions/featherless/index.ts",
      "./extensions/fence/index.ts",
      "./extensions/system-prompt/index.ts",
      "./extensions/workspace/index.ts"
    ],
    "skills": [
      "./skills/pi",
      "./skills/mlegls-pi"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "bun-types": "^1.4.2",
    "typebox": "1.3.7"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "tsx": "^4.23.13"
  },
  "type": "module",
  "optionalDependencies": {
    "@injaneity/pi-computer-use": "github:mlegls/pi-computer-use#6772738c32a6c58e97233b33708c5c2430a5c5fc"
  }
}
