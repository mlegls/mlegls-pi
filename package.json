{
  "name": "mlegls-pi",
  "version": "0.1.0",
  "description": "Personal pi package for mlegls",
  "scripts": {
    "setup": "bun install --frozen-lockfile && bun install --cwd extensions/outline-read --frozen-lockfile && bun install --cwd extensions/disabled/lsp --frozen-lockfile",
    "test:board": "bun test extensions/board",
    "test:exa": "bun test extensions/exa",
    "test:lsp": "bun test extensions/lsp",
    "test:outline-read": "bun test extensions/outline-read",
    "test:session": "bun test extensions/session",
    "test:lib": "bun test lib",
    "test:system-prompt": "bun test extensions/system-prompt",
    "test:workspace": "bun test extensions/workspace"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "bun-types": "^1.4.2",
    "typebox": "1.3.7"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  }
}
