{
  "name": "mlegls-pi",
  "version": "0.2.0",
  "description": "Personal pi package for mlegls",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "setup": "bun install --frozen-lockfile",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/system-prompt/index.ts",
      "./extensions/fragment/index.ts",
      "./extensions/workspace/index.ts",
      "./extensions/context/index.ts",
      "./lib/board/host.ts",
      "./lib/session-meta/host.ts",
      "./extensions/stances/index.ts",
      "./extensions/supervision/index.ts",
    "./extensions/guard/index.ts",
      "./extensions/error-images/index.ts"
    ],
    "skills": [
      "./skills/enabled/pi/pi",
      "./skills/enabled/pi/mlegls-pi"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "bun-types": "^1.4.2",
    "typebox": "1.3.7",
    "typescript": "5"
  },
  "dependencies": {
    "@morphllm/morphsdk": "^0.2.196",
    "diff": "^8",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.10",
    "yaml": "2.9.0"
  }
}
