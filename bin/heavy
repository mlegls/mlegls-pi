#!/usr/bin/env bash
# heavy [-b] CMD [ARG...]: run CMD once one of the host's heavy-work slots is
# free, FIFO across every caller on the host (GNU parallel's sem). CMD stays in
# this process tree, with this caller's output and exit status. HEAVY_SLOTS
# sets the slot count (default 2). CMD runs at lower CPU priority than the
# agents waiting on it (nice 10 on Linux); -b lowers it further, for work
# nobody waits on (taskpolicy -b on macOS, nice 19 on Linux).
# A CMD already holding a slot (HEAVY_HELD, inherited) runs nested heavy calls
# directly, so wrapping both a task and its subtasks cannot deadlock the queue.
set -u
background=
[ "${1:-}" = -b ] && { background=1; shift; }
[ $# -gt 0 ] || { echo "usage: heavy [-b] CMD [ARG...]" >&2; exit 2; }
[ -n "${HEAVY_HELD:-}" ] && exec "$@"
if command -v taskpolicy >/dev/null; then
	[ -n "$background" ] && set -- taskpolicy -b "$@"
else
	set -- nice -n "${background:+19}${background:-10}" "$@"
fi
export HEAVY_HELD=1
# A waiting sem ignores SIGTERM and still runs CMD once a slot frees; it honours
# SIGINT, so a stopped caller forwards TERM as INT.
# -u: sem otherwise buffers CMD's output until it exits.
sem --id heavy -j "${HEAVY_SLOTS:-2}" --fg -u -q -- "$@" &
pid=$!
trap 'kill -INT "$pid" 2>/dev/null' TERM INT HUP
while :; do
	wait "$pid"
	status=$?
	kill -0 "$pid" 2>/dev/null || exit "$status"
done
