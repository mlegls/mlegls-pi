#!/usr/bin/env bash
# heavy [-b] CMD [ARG...]: run CMD once one of the host's heavy-work slots is
# free, FIFO across every caller on the host (GNU parallel's sem). CMD stays in
# this process tree, with this caller's output and exit status. HEAVY_SLOTS
# sets the slot count (default 4); a free slot also waits while bin/heavy-gate
# reports the host under CPU or memory pressure, so the count is a ceiling and
# load sets the working concurrency. CMD runs at lower CPU priority than the
# agents waiting on it (nice 10 on Linux); -b lowers it further, for work
# nobody waits on (taskpolicy -b on macOS, nice 19 on Linux).
# A CMD already holding a slot (HEAVY_HELD, inherited) runs nested heavy calls
# directly, so wrapping both a task and its subtasks cannot deadlock the queue.
# Where systemd --user scopes work, each run's cwd, HEAD, exit, wall time and peak
# memory append to ~/.local/state/heavy/runs.jsonl (bin/heavy-record).
set -u
background=
[ "${1:-}" = -b ] && { background=1; shift; }
[ $# -gt 0 ] || { echo "usage: heavy [-b] CMD [ARG...]" >&2; exit 2; }
[ -n "${HEAVY_HELD:-}" ] && exec "$@"
bin="$(cd "$(dirname "$0")" && pwd)"
# Each run gets its own systemd --user scope, where bin/heavy-record logs CMD's
# peak memory; OOMPolicy=continue keeps the recorder alive when CMD is OOM-killed.
scope=
command -v systemd-run >/dev/null && systemd-run --user --scope --quiet true 2>/dev/null && scope=1
[ -n "$scope" ] && set -- "$bin/heavy-record" heavy "$@"
if command -v taskpolicy >/dev/null; then
	[ -n "$background" ] && set -- taskpolicy -b "$@"
else
	set -- nice -n "${background:+19}${background:-10}" "$@"
fi
# sem exports an empty XDG_CACHE_HOME, which Bun reads as a relative cache
# root and fills ./bun/@t@ in whatever directory CMD runs from.
if [ -n "${XDG_CACHE_HOME:-}" ]; then
	set -- env XDG_CACHE_HOME="$XDG_CACHE_HOME" "$@"
else
	set -- env -u XDG_CACHE_HOME "$@"
fi
[ -n "$scope" ] && set -- systemd-run --user --scope --quiet --collect -p OOMPolicy=continue -- "$@"
export HEAVY_HELD=1 HEAVY_QUEUED_AT="$(date +%s.%N)"
# A waiting sem ignores SIGTERM and still runs CMD once a slot frees; it honours
# SIGINT, so a stopped caller forwards TERM as INT.
# -u: sem otherwise buffers CMD's output until it exits.
gate="$bin/heavy-gate"
sem --id heavy -j "${HEAVY_SLOTS:-4}" --limit "'$gate'" --fg -u -q -- "$@" &
pid=$!
trap 'kill -INT "$pid" 2>/dev/null' TERM INT HUP
while :; do
	wait "$pid"
	status=$?
	kill -0 "$pid" 2>/dev/null || exit "$status"
done
