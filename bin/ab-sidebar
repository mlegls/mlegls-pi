#!/bin/sh
# One persistent `ab tree ui --sidebar` pane that follows you: tmux hooks move it (join-pane,
# same process) into whichever window you switch to, so it behaves like a global side panel.
#   ab-sidebar toggle   show/hide, remembered across tmux restarts
#   ab-sidebar follow   (hooks) move the sidebar into the current window if it's on
#   ab-sidebar restore  (tmux.conf) re-apply the remembered state
state=${XDG_STATE_HOME:-$HOME/.local/state}/ab-tree/sidebar
width=${AB_SIDEBAR_WIDTH:-38}
ab=$(dirname "$(readlink -f "$0")")/ab
pane() { tmux list-panes -a -F '#{pane_id} #{@ab-sidebar-pane}' | awk '$2 == "1" { print $1; exit }'; }
on() { [ "$(tmux show -gqv @ab-sidebar-on)" = 1 ]; }
here() { tmux display -p '#{window_id}'; }

follow() {
	on || return 0
	p=$(pane)
	win=${1:-$(here)}
	[ -n "$win" ] || return 0
	if [ -z "$p" ]; then
		p=$(tmux split-window -dhbf -l "$width" -t "$win" -P -F '#{pane_id}' "$ab tree ui --sidebar")
		tmux set -p -t "$p" @ab-sidebar-pane 1
	elif [ "$(tmux display -p -t "$p" '#{window_id}')" != "$win" ]; then
		tmux join-pane -dhbf -l "$width" -s "$p" -t "$win" 2>/dev/null || return 0
	fi
	tmux resize-pane -t "$p" -x "$width" 2>/dev/null
	tmux send-keys -t "$p" r 2>/dev/null
}

case "${1:-toggle}" in
	toggle)
		mkdir -p "$(dirname "$state")"
		if on; then
			tmux set -g @ab-sidebar-on 0; echo 0 > "$state"
			p=$(pane); [ -n "$p" ] && tmux kill-pane -t "$p"
		else
			tmux set -g @ab-sidebar-on 1; echo 1 > "$state"; follow
		fi ;;
	follow) follow "$2" ;;
	restore) [ "$(cat "$state" 2>/dev/null)" = 1 ] && tmux set -g @ab-sidebar-on 1 && follow; true ;;
esac
