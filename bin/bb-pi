#!/bin/sh
# pi as bb's Pi provider runs it (BB_PI_BRIDGE_COMMAND). bb sets one environment for every thread, so a worker's
# identity (board topic, stance, checkpoint ratio) comes from .wm/launch.env in its worktree, written at launch.
if [ -f .wm/launch.env ]; then set -a; . ./.wm/launch.env; set +a; fi
exec pi "$@"
