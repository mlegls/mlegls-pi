#!/bin/sh
# pi as bb's Pi provider runs it (BB_PI_BRIDGE_COMMAND). bb sets one environment for every thread, so a worker's
# identity (run, handle, stance, checkpoint ratio) comes from .wm/launch.env in its worktree, written at launch.
# bb also starts a sessionless pi (--no-session) in the same cwd beside each thread's own: it must not take the
# worker's identity, or it runs as a second writer on the worker.
case " $* " in
*" --no-session "*) ;;
*) if [ -f .wm/launch.env ]; then set -a; . ./.wm/launch.env; set +a; fi ;;
esac
# bb passes its own --append-system-prompt, and pi then skips discovering the personal APPEND_SYSTEM.md, so add it
# after bb's: its conventions (host-for-human, not bb connect expose) override bb's generic guidance.
case " $* " in
*" --append-system-prompt "*)
	f="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/APPEND_SYSTEM.md"
	if [ -f "$f" ]; then set -- "$@" --append-system-prompt "$f"; fi ;;
esac
exec pi "$@"
