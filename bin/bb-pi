#!/bin/sh
# bb can start a sessionless Pi beside the worker on the same provider environment.
# Only the session-carrying Pi may record the worker's identity.
case " $* " in
*" --no-session "*) unset PI_WM_RUN PI_WM_HANDLE PI_WM_ISSUE PI_WM_AGENT PI_WM_PARENT_SESSION PI_CHECKPOINT ;;
esac
# bb passes its own --append-system-prompt, and pi then skips discovering the personal APPEND_SYSTEM.md, so add it
# after bb's: its conventions (host-for-human, not bb connect expose) override bb's generic guidance.
case " $* " in
*" --append-system-prompt "*)
	f="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/APPEND_SYSTEM.md"
	if [ -f "$f" ]; then set -- "$@" --append-system-prompt "$f"; fi ;;
esac
exec pi "$@"
