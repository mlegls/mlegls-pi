#!/usr/bin/env python3
"""Publish a review page on Tailscale HTTPS, optionally owning its upstream in user systemd."""
import argparse
import fcntl
import hashlib
from html.parser import HTMLParser
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import time
from urllib.error import URLError
from urllib.parse import urljoin, urlsplit
from urllib.request import ProxyHandler, build_opener

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "host-for-human"
PORTS = range(10000, 10004)
UNITS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "systemd/user"


def run(*args):
    result = subprocess.run(args, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(f"{' '.join(args)}: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout


def config():
    return json.loads(run("tailscale", "serve", "status", "--json"))


def proxy_at(cfg, https_port):
    for host, web in cfg.get("Web", {}).items():
        if host.endswith(f":{https_port}"):
            return web.get("Handlers", {}).get("/", {}).get("Proxy")
    return None


def occupied_ports(cfg):
    return {int(p) for p in cfg.get("TCP", {})} | {
        int(host.rsplit(":", 1)[1]) for host in cfg.get("Web", {})
    }


def refused(proxy):
    try:
        upstream = urlsplit(proxy.replace("https+insecure://", "https://", 1))
        if upstream.scheme not in ("http", "https") or not upstream.hostname:
            return False
        with socket.create_connection(
            (upstream.hostname, upstream.port or (443 if upstream.scheme == "https" else 80)),
            timeout=1,
        ):
            return False
    except ConnectionRefusedError:
        return True
    except (OSError, ValueError):
        # A timeout, DNS failure or unknown target does not establish refusal.
        return False


def unmap(https_port, proxy):
    if proxy_at(config(), https_port) == proxy:
        run("tailscale", "serve", f"--https={https_port}", "off")


def map_review(https_port, proxy):
    cfg = config()
    current = proxy_at(cfg, https_port)
    if https_port in occupied_ports(cfg) and current != proxy:
        raise RuntimeError("HTTPS mapping changed owner; refusing to overwrite it")
    run("tailscale", "serve", "--bg", f"--https={https_port}", proxy)


def stop_server(record):
    if record.get("unit_file"):
        run("systemctl", "--user", "disable", record["unit"])
        stopped = subprocess.run(["systemctl", "--user", "stop", record["unit"]], capture_output=True)
        if stopped.returncode and run(
            "systemctl", "--user", "show", "--property=ActiveState", "--value", record["unit"]
        ).strip() not in ("inactive", "failed"):
            raise RuntimeError(f"could not stop {record['unit']}")
        Path(record["unit_file"]).unlink(missing_ok=True)
        run("systemctl", "--user", "daemon-reload")
    elif record.get("unit"):
        subprocess.run(["systemctl", "--user", "stop", record["unit"]], capture_output=True)


def reclaim(keep):
    for path in STATE.glob("*.json"):
        if path == keep:
            continue
        record = json.loads(path.read_text())
        missing = record["directory"] and not Path(record["directory"]).is_dir()
        inactive = record.get("unit") and run(
            "systemctl", "--user", "show", "--property=ActiveState", "--value", record["unit"]
        ).strip() in ("inactive", "failed")
        if missing or inactive or (not record.get("unit") and refused(record["proxy"])):
            stop_server(record)
            unmap(record["https_port"], record["proxy"])
            path.unlink()
            print(f"reclaimed review {record['name']!r}: {record['proxy']} "
                  f"(HTTPS {record['https_port']})", file=sys.stderr)

    cfg = config()
    for port in PORTS:
        handlers = [
            handler for host, web in cfg.get("Web", {}).items()
            if host.endswith(f":{port}") for handler in web.get("Handlers", {}).values()
        ]
        # Removing the port also removes its other paths: all must be refused proxies.
        if handlers and all(h.get("Proxy") and refused(h["Proxy"]) for h in handlers):
            proxies = ", ".join(h["Proxy"] for h in handlers)
            run("tailscale", "serve", f"--https={port}", "off")
            print(f"removed refused mapping HTTPS {port} -> {proxies}", file=sys.stderr)
            for path in STATE.glob("*.json"):
                if path == keep:
                    continue
                record = json.loads(path.read_text())
                if record["https_port"] == port:
                    stop_server(record)
                    path.unlink()
    return config()


def unit_quote(value):
    return json.dumps(value, ensure_ascii=False).replace("%", "%%")


def unit_command(*args):
    return " ".join(unit_quote(str(arg)).replace("$", "$$") for arg in args)


def persistent_server(record):
    # The stop/start helper must survive retirement of the publishing worktree.
    helper = STATE / "service-helper.py"
    temp = helper.with_suffix(".tmp")
    temp.write_text(Path(__file__).read_text())
    temp.replace(helper)
    unit_file = Path(record["unit_file"])
    unit_file.parent.mkdir(parents=True, exist_ok=True)
    helper_args = (sys.executable, helper)
    text = "\n".join([
        "[Unit]",
        f"Description=Review page {record['unit']}",
        "StartLimitIntervalSec=0",
        "[Service]",
        "Type=exec",
        # CLIs such as Lavish fork their server and return; own the whole cgroup.
        "ExitType=cgroup",
        "WorkingDirectory=" + record["cwd"].replace("%", "%%").replace("\n", "\\n"),
        f"Environment={unit_quote('PATH=' + record['path'])}",
        f"ExecStart={unit_command('/bin/sh', '-c', record['command'])}",
        f"ExecStartPost={unit_command(*helper_args, '--map', record['https_port'], record['proxy'])}",
        f"ExecStopPost={unit_command(*helper_args, '--unmap', record['https_port'], record['proxy'])}",
        "Restart=always",
        "RestartSec=2",
        "[Install]",
        "WantedBy=default.target",
        "",
    ])
    changed = not unit_file.exists() or unit_file.read_text() != text
    unit_file.write_text(text)
    run("systemctl", "--user", "daemon-reload")
    subprocess.run(["systemctl", "--user", "reset-failed", record["unit"]], capture_output=True)
    run("systemctl", "--user", "enable", record["unit"])
    run("systemctl", "--user", "restart" if changed else "start", record["unit"])


class Assets(HTMLParser):
    def __init__(self):
        super().__init__()
        self.urls = []
        self.base = None

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "base" and attrs.get("href"):
            self.base = attrs["href"]
        if tag == "script" and attrs.get("src"):
            self.urls.append(attrs["src"])
        if tag == "link" and "stylesheet" in attrs.get("rel", "").split() and attrs.get("href"):
            self.urls.append(attrs["href"])


# Tailnet requests must not go through an ambient HTTP proxy.
HTTP = build_opener(ProxyHandler({}))


def fetch(url):
    # tailscale serve can return before its HTTPS listener is accepting connections.
    for attempt in range(20):
        try:
            with HTTP.open(url, timeout=10) as response:
                if response.status != 200:
                    raise RuntimeError(f"{url}: expected HTTP 200, got {response.status}")
                return response.read().decode("utf-8", errors="replace")
        except URLError as error:
            if not isinstance(error.reason, ConnectionRefusedError) or attempt == 19:
                raise
            time.sleep(0.25)


def check(url):
    assets = Assets()
    assets.feed(fetch(url))
    if assets.urls:
        asset = urljoin(urljoin(url, assets.base or ""), assets.urls[0])
        fetch(asset)
        print(f"checked page and asset: {asset}", file=sys.stderr)
    else:
        print("checked page (no external stylesheet or script referenced)", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", help="directory, or localhost port (already running unless --run is given)")
    parser.add_argument("--name", help="stable review identity (default: absolute directory or port)")
    parser.add_argument("--stop", action="store_true", help="stop this review's owned server and HTTPS mapping")
    parser.add_argument("--run", dest="command", help="own this upstream shell command in a reboot-persistent user service (port target only)")
    args = parser.parse_args()
    directory = None if args.target.isdecimal() else str(Path(args.target).resolve())
    identity = args.name or directory or f"port-{args.target}"
    key = hashlib.sha256(identity.encode()).hexdigest()[:20]
    unit = f"host-for-human-{key}"
    STATE.mkdir(parents=True, exist_ok=True)
    state_file = STATE / f"{key}.json"
    with (STATE / "publish.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        saved = json.loads(state_file.read_text()) if state_file.exists() else None
        cfg = config()
        if args.stop:
            if not saved:
                raise RuntimeError(f"no review named {identity!r}")
            current = proxy_at(cfg, saved["https_port"])
            if current and current != saved["proxy"]:
                raise RuntimeError("HTTPS mapping changed owner; refusing to remove it")
            if current:
                run("tailscale", "serve", f"--https={saved['https_port']}", "off")
            stop_server(saved)
            state_file.unlink()
            return

        if args.command and directory:
            raise RuntimeError("--run requires a port target")
        if directory and not Path(directory).is_dir():
            raise RuntimeError(f"not a directory: {directory}")
        if not directory and not 1 <= int(args.target) <= 65535:
            raise RuntimeError("port must be between 1 and 65535")
        if saved and (saved["directory"] != directory or
                      (not directory and saved["port"] != int(args.target))):
            raise RuntimeError("name already belongs to a different target; use its original target or --stop first")

        command = args.command or (saved or {}).get("command")
        if saved and args.command and args.command != saved.get("command"):
            raise RuntimeError("name already belongs to a different command; --stop first")
        if command:
            run("systemctl", "--user", "show-environment")
            active = saved and subprocess.run(
                ["systemctl", "--user", "is-active", "--quiet", unit], capture_output=True
            ).returncode == 0
            if not active and not refused(f"http://127.0.0.1:{args.target}"):
                raise RuntimeError("upstream port is already in use; --run needs its own unused port")
            run("loginctl", "enable-linger", str(os.getuid()))

        if saved:
            https_port = saved["https_port"]
            current = proxy_at(cfg, https_port)
            if current and current != saved["proxy"]:
                raise RuntimeError("HTTPS mapping changed owner; refusing to overwrite it")
        else:
            cfg = reclaim(state_file)
            occupied = occupied_ports(cfg)
            occupied.update(json.loads(p.read_text())["https_port"] for p in STATE.glob("*.json"))
            https_port = next((p for p in PORTS if p not in occupied), None)
            if https_port is None:
                raise RuntimeError("no free Tailscale HTTPS port in 10000–10003; no refused upstreams or stale reservations to reclaim")

        if directory:
            run("systemctl", "--user", "show-environment")
            if saved:
                port = saved["port"]
            else:
                with socket.socket() as sock:
                    sock.bind(("127.0.0.1", 0))
                    port = sock.getsockname()[1]
        else:
            port = int(args.target)
        proxy = f"http://127.0.0.1:{port}"
        host = json.loads(run("tailscale", "status", "--json"))["Self"]["DNSName"].rstrip(".")
        page = "/canvas.html" if directory and not (Path(directory) / "index.html").exists() and (Path(directory) / "canvas.html").exists() else "/"
        record = {
            "name": identity, "purpose": "maintainer review page",
            "owner_thread": (saved or {}).get("owner_thread") or os.environ.get("BB_THREAD_ID"),
            "last_publisher_thread": os.environ.get("BB_THREAD_ID"),
            "directory": directory, "port": port, "https_port": https_port,
            "proxy": proxy, "unit": unit if directory or command else None,
            "command": command,
            "cwd": (saved or {}).get("cwd") or str(Path.cwd()),
            "path": (saved or {}).get("path") or os.environ.get("PATH", os.defpath),
            "unit_file": str(UNITS / f"{unit}.service") if command else None,
            "url": f"https://{host}:{https_port}{page}",
        }
        # Reserve before launching so a failed publish can be repaired with the same name.
        temp = state_file.with_suffix(".tmp")
        temp.write_text(json.dumps(record, indent=2) + "\n")
        temp.replace(state_file)
        if command:
            persistent_server(record)
        if directory and subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", unit], capture_output=True
        ).returncode:
            # Collect a stopped/failed (or auto-restarting) unit before recreating it.
            subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True)
            subprocess.run(["systemctl", "--user", "reset-failed", unit], capture_output=True)
            run("systemd-run", "--user", "--collect", f"--unit={unit}",
                f"--description=Review page {identity} (owner {record['owner_thread'] or 'manual'})",
                "--property=Restart=on-failure", "--property=RestartSec=2",
                "--", shutil.which("python3"), "-m", "http.server", str(port),
                "--bind", "127.0.0.1", "--directory", directory)
        # The localhost probe is a readiness check, not the published-page check.
        for attempt in range(20):
            try:
                fetch(proxy + page)
                break
            except Exception:
                if attempt == 19:
                    raise RuntimeError(f"server not ready at {proxy}; restart its owner if using port mode")
                time.sleep(0.25)
        map_review(https_port, proxy)
        check(record["url"])
        print(record["url"])


if __name__ == "__main__":
    try:
        if sys.argv[1:2] == ["--map"]:
            map_review(int(sys.argv[2]), sys.argv[3])
        elif sys.argv[1:2] == ["--unmap"]:
            unmap(int(sys.argv[2]), sys.argv[3])
        else:
            main()
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        print(f"host-for-human: {error}", file=sys.stderr)
        sys.exit(1)
