#!/bin/sh
# A terminal may start with a cwd that can't be resolved (PWD=".", getcwd fails),
# which makes Bun's process.cwd() throw. Re-enter the directory by absolute path.
if ! /bin/pwd -P >/dev/null 2>&1; then
	case "$PWD" in /*) dir=$PWD ;; esac
	cd "${dir:-$HOME}" 2>/dev/null || cd "$HOME"
fi
if [ "$1" = desk ]; then
	shift
	exec "$(dirname "$(readlink -f "$0")")/desk" "$@"
fi
echo "usage: ab desk ..." >&2
exit 2
