{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": [
      "esnext",
      "dom"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "build.ts"
  ]
}
